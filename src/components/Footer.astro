---
import { site } from "../data/site";

const path = Astro.url.pathname;
const extra = path.startsWith("/contact/")
  ? { label: "Team", href: "/team/" }
  : { label: "Contact", href: "/contact/" };
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-brand">{site.name}</p>
      <p class="footer-meta">© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
    </div>
    <ul class="footer-links">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>
      <li>
        <a href={site.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
      </li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href={extra.href}>{extra.label}</a></li>
    </ul>
  </div>
</footer>
