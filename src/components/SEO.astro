---
import { site } from "../data/site";
import { team } from "../data/team";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  markdownAlternate?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = site.logo,
  type = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  markdownAlternate,
  jsonLd = [],
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site.url}/#organization`,
  name: site.name,
  url: `${site.url}/`,
  logo: new URL(site.logo, site.url).href,
  description: site.description,
  email: site.email,
  telephone: site.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Hyderabad",
    addressCountry: "IN",
  },
  sameAs: [site.linkedin],
  founder: team
    .filter((p) => p.founder)
    .map((p) => ({ "@type": "Person", name: p.name, jobTitle: p.role })),
};

const schemas = [organization, ...jsonLd];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
<meta name="theme-color" content="#f5f5f5" />
<meta name="author" content={site.name} />

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_IN" />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={site.name} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />
<link rel="alternate" type="text/plain" title="LLM-friendly site summary" href="/llms.txt" />
{markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

{schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
