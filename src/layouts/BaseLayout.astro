---
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import "../styles/global.css";

export type Props = SEOProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <SEO {...Astro.props} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=JetBrains+Mono:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={site.logo} type="image/png" />
    <link rel="apple-touch-icon" href={site.logo} />
    <slot name="head" />
  </head>
  <body>
    <div class="page-bg" aria-hidden="true"></div>
    <slot name="before-header" />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
