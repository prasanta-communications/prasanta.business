---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { site } from "../../data/site";
import { getPublishedPosts, postUrl } from "../../lib/posts";

const posts = await getPublishedPosts();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: `Blog | ${site.name}`,
    url: `${site.url}/blog/`,
    publisher: { "@id": `${site.url}/#organization` },
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      url: new URL(postUrl(post), site.url).href,
    })),
  },
];
---

<BaseLayout
  title="Blog"
  description="Product overviews, build notes, and updates from Prasanta Communications."
  jsonLd={jsonLd}
>
  <header class="page-hero wrap">
    <p class="section-label reveal">Index / blog</p>
    <h1 class="page-title reveal">
      <span class="page-title-ghost" aria-hidden="true">Blog</span>
      Blog
    </h1>
    <p class="page-lead reveal reveal-delay-1">
      Product overviews, build notes, and what we are learning while shipping.
    </p>
    <p class="blog-hero-links reveal reveal-delay-2">
      <a class="product-link" href="/blog/tags/">Browse by tag →</a>
    </p>
  </header>

  {
    posts.length > 0 ? (
      <section class="product-stack blog-list" aria-label="Posts">
        {posts.map((post, i) => (
          <PostCard post={post} index={i} headingLevel="h2" />
        ))}
      </section>
    ) : (
      <section class="blog-empty wrap reveal" aria-label="Posts">
        <p class="blog-empty-title">Nothing published yet.</p>
        <p class="blog-empty-copy">
          We are writing up our products right now. Check back soon, or follow along via{" "}
          <a class="link-underline" href="/rss.xml">
            RSS
          </a>
          .
        </p>
      </section>
    )
  }
</BaseLayout>
