---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { site } from "../../../data/site";
import {
  getPublishedPosts,
  getTags,
  postUrl,
  tagSlug,
  tagUrl,
  type Post,
  type Tag,
} from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.some((t) => tagSlug(t) === tag.slug)),
    },
  }));
}

const { tag, posts } = Astro.props as { tag: Tag; posts: Post[] };
const url = new URL(tagUrl(tag.name), site.url).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${tag.name} | ${site.name}`,
    url,
    isPartOf: { "@type": "Blog", url: `${site.url}/blog/` },
    hasPart: posts.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      url: new URL(postUrl(post), site.url).href,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${site.url}/blog/` },
      { "@type": "ListItem", position: 3, name: "Tags", item: `${site.url}/blog/tags/` },
      { "@type": "ListItem", position: 4, name: tag.name, item: url },
    ],
  },
];
---

<BaseLayout
  title={`Posts tagged "${tag.name}"`}
  description={`Prasanta Communications blog posts tagged "${tag.name}".`}
  jsonLd={jsonLd}
>
  <header class="page-hero wrap">
    <nav class="section-label reveal post-crumbs" aria-label="Breadcrumb">
      <a href="/blog/">Index / blog</a> / <a href="/blog/tags/">tags</a>
    </nav>
    <h1 class="post-title reveal">{tag.name}</h1>
    <p class="page-lead reveal reveal-delay-1">
      {posts.length} {posts.length === 1 ? "post" : "posts"} tagged “{tag.name}”.{" "}
      <a class="link-underline" href="/blog/tags/">All tags →</a>
    </p>
  </header>

  <section class="product-stack blog-list" aria-label="Posts">
    {posts.map((post, i) => <PostCard post={post} index={i} headingLevel="h2" />)}
  </section>
</BaseLayout>
